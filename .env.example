# Local server
PORT=8787
DB_PATH=./data/campaign.sqlite

# Public hosting protection. Required in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# LLM: Groq first, then Ollama fallback
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_API_KEY_1=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# WhatsApp Web is the active/default transport.
WHATSAPP_WEB_ENABLED=true
WHATSAPP_WEB_AUTH_PATH=.wwebjs_auth
# Leave empty to let Puppeteer use its installed browser.
CHROME_EXECUTABLE_PATH=
ENABLE_WEB_SIMULATION=false

# Optional/later: WhatsApp Cloud API.
# Leave these empty while using WhatsApp Web only.
WA_CLOUD_ACCESS_TOKEN=
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_VERIFY_TOKEN=change-me
WA_CLOUD_API_VERSION=v20.0
WA_CLOUD_TEMPLATE_NAME=
WA_CLOUD_TEMPLATE_LANGUAGE=en
WA_CLOUD_TEMPLATE_BODY_PARAMS=fullName,programOfStudy
WA_CLOUD_ALLOW_TEXT_INITIAL=false
